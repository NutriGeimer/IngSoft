{
  "hosting": {
    "site": "beeparking-ug",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".gitignore",
      "node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/",
        "destination": "/login.html"
      },
      {
        "source": "/register",
        "destination": "/register.html"
      },
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      },
      {
        "source": "/parking",
        "destination": "/parking.html"
      },
      {
        "source": "/access",
        "destination": "/access.html"
      },
      {
        "source": "/validate",
        "destination": "/validate.html"
      },
      {
        "source": "/historialAccesos",
        "destination": "/historialAccesos.html"
      }
    ]
  }
}
